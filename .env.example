# 복사해서 .env로 저장 후 값 입력 (.env는 커밋 금지)
# OpenAI 키는 백엔드에서만 사용. 프론트엔드에서 직접 호출 금지.

# LLM (메인: GPT-5.4 mini, 날짜 스냅샷 이름으로 고정)
OPENAI_API_KEY=
OPENAI_MODEL=               # 예: 날짜가 붙은 gpt-5.4-mini 스냅샷 이름
OPENAI_MODEL_COMPARE=       # 예: 날짜가 붙은 gpt-5.4-nano 스냅샷 이름

# HyperCLOVA X (비교용, CLOVA Studio)
CLOVA_API_KEY=
CLOVA_MODEL=HCX-DASH-002

# 공공데이터
DATA_GO_KR_API_KEY=         # 공공데이터포털
SGIS_CONSUMER_KEY=          # 통계청 SGIS
SGIS_CONSUMER_SECRET=
VWORLD_API_KEY=             # 브이월드 (지오코딩·배경지도, 배포 주소 등록 필요)
